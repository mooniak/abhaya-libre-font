# QA, proofs and published artifacts (all regenerated by make/CI) #
###################################################################
# out/ = fontspector report, badges, diffenator2 proofs, PDF proof books, fontstatus.json
/out
# stage-gated proof site written by `make pages`
/_site
# release assets staged by scripts/publish_channel.sh
/publish
# legacy top-level proof directory (proofs now go to out/proof)
proof

